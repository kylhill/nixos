#!/usr/bin/env bash
set -euo pipefail
tool=${0##*/}
printf '%s %s\n' "$tool" "$*" >> "$FIXTURE_LOG"
if [[ $tool != nix ]]; then
    [[ ${FAIL_TOOL:-} != "$tool" ]]
    exit
fi
if [[ $* == *'--store daemon'* && ${FAIL_DAEMON:-0} == 1 ]]; then
    echo 'cannot connect to daemon socket: Operation not permitted' >&2
    exit 1
fi
case "$*" in
    *'store info'*) [[ ${FAIL_DAEMON:-0} != 1 ]] ;;
    *concatStringsSep*)
        [[ ${FAIL_RESOLVE:-0} != 1 ]] || exit 1
        for name in nixfmt statix deadnix shellcheck; do
            printf '%s %s\n' "$name" "$FIXTURE_TOOLS"
        done
        ;;
    *builtins.currentSystem*) printf x86_64-linux ;;
    *homeConfigurations.missing*) exit 1 ;;
    *) printf '{}\n' ;;
esac
