#!/usr/bin/env bash
set -euo pipefail
tool=${0##*/}
printf '%s NIX_REMOTE=%s XDG_CACHE_HOME=%s %s\n' \
    "$tool" "${NIX_REMOTE:-}" "${XDG_CACHE_HOME:-}" "$*" >> "$FIXTURE_LOG"
if [[ $tool != nix ]]; then
    [[ ${FAIL_TOOL:-} != "$tool" ]]
    exit
fi
case "$*" in
    *builtins.currentSystem*) printf x86_64-linux ;;
    *homeConfigurations.missing*) exit 1 ;;
    *) printf '{}\n' ;;
esac
