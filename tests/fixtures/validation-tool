#!/usr/bin/env bash
set -euo pipefail
tool=${0##*/}
# NUL fields preserve empty arguments, spaces and embedded newlines. Each call
# has a tool, three environment fields, argc, then exactly argc arguments.
printf '%s\0' "$tool" "${NIX_REMOTE:-}" "${NIX_CACHE_HOME:-}" "${XDG_CACHE_HOME:-}" "$#" "$@" >> "$FIXTURE_LOG"
if [[ $tool != nix ]]; then
    [[ ${FAIL_TOOL:-} != "$tool" ]]
    exit
fi
for arg in "$@"; do
    if [[ -n ${FAIL_NIX_MATCH:-} && $arg == *"$FAIL_NIX_MATCH"* ]]; then exit 1; fi
    case "$arg" in
        *homeConfigurations.missing*) exit 1 ;;
    esac
done
if [[ ${1:-} == eval && ${*: -1} == builtins.currentSystem ]]; then
    printf x86_64-linux
else
    printf '{}\n'
fi
