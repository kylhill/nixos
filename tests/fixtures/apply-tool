#!/usr/bin/env bash
set -euo pipefail

tool=${0##*/}
case "$tool" in
    hostname) printf '%s\n' "${FIXTURE_HOST:?}" ;;
    grep)
        if [[ $* == '-qi microsoft /proc/sys/kernel/osrelease' ]]; then
            [[ ${FIXTURE_KERNEL_WSL:-false} == true ]]
        else
            exec "$FIXTURE_GREP" "$@"
        fi
        ;;
    *)
        printf '%s %s\n' "$tool" "$*" >> "${FIXTURE_LOG:?}"
        if [[ ${FAIL_APPLY_TOOL:-} == "$tool" ]]; then exit 17; fi
        ;;
esac
