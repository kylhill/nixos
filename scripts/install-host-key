#!/usr/bin/env bash
set -euo pipefail

expected_recipient="age1u9vjethkehj45wylw2dseya2tak992xfvelh7ky76hfvfjfmnyzqfmdzw0"
source_key="${1:-}"
target_root="${2:-/mnt}"
target_key="$target_root/var/lib/sops-nix/key.txt"

fail() {
    echo "host-key installation failed: $*" >&2
    exit 1
}

key_recipient() {
    if command -v age-keygen >/dev/null 2>&1; then
        age-keygen -y "$1"
    else
        env NIX_CONFIG='experimental-features = nix-command flakes' \
            nix shell nixpkgs#age -c age-keygen -y "$1"
    fi
}

[[ $EUID -eq 0 ]] || fail "run this script with sudo"
[[ -n "$source_key" ]] || fail "usage: sudo $0 /path/to/pang14-host.txt [/mnt]"
[[ -f "$source_key" ]] || fail "source key does not exist: $source_key"
[[ -d "$target_root" ]] || fail "target root does not exist: $target_root"

var_source=$(findmnt -n -o SOURCE --target "$target_root/var" 2>/dev/null || true)
[[ "$var_source" == "rpool/var" ]] ||
    fail "$target_root/var is mounted from '${var_source:-nothing}', expected rpool/var"

recipient=$(key_recipient "$source_key")
[[ "$recipient" == "$expected_recipient" ]] ||
    fail "source key has recipient $recipient, expected $expected_recipient"

install -D -m 0600 "$source_key" "$target_key"

installed_recipient=$(key_recipient "$target_key")
[[ "$installed_recipient" == "$expected_recipient" ]] ||
    fail "installed key failed recipient verification"

echo "Installed and verified the pang14 host identity at $target_key"
echo "Recipient: $installed_recipient"
