{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allDigest"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "enabledManagers": [
    "github-actions",
    "nix"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "Nix flake dependencies",
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "matchPackageNames": [
        "docker.io/renovate/renovate"
      ],
      "changelogUrl": "https://github.com/renovatebot/renovate/releases"
    },
    {
      "description": "Update CI runtimes only when their version changes",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/renovate/renovate"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    },
    {
      "description": "Disable digest-only updates for Forgejo actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".forgejo/workflows/**"
      ],
      "matchDepTypes": [
        "action",
        "workflow"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    }
  ]
}
