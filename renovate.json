{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "enabledManagers": [
    "github-actions",
    "nix"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "Nix flake dependencies",
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "nix"
      ],
      "groupName": "Nix flake dependencies"
    }
  ],
  "automerge": false,
  "dependencyDashboard": false,
  "prConcurrentLimit": 2
}
