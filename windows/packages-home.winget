# Applications installed on home Windows workstations.
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
- type: Microsoft.WinGet/Package
  name: PackageDeluge
  properties:
    id: DelugeTeam.Deluge
    source: winget
  metadata:
    description: Install Deluge
- type: Microsoft.WinGet/Package
  name: PackageNextcloud
  properties:
    id: Nextcloud.NextcloudDesktop
    source: winget
  metadata:
    description: Install Nextcloud Desktop
- type: Microsoft.WinGet/Package
  name: PackageSteam
  properties:
    id: Valve.Steam
    source: winget
  metadata:
    description: Install Steam
- type: Microsoft.WinGet/Package
  name: PackageWireGuard
  properties:
    id: WireGuard.WireGuard
    source: winget
  metadata:
    description: Install WireGuard
