- type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  name: RemoveRecommendedInboxApps
  dependsOn:
  - PackagePowerShell
  properties:
    input:
    - Microsoft.Copilot
    - Clipchamp.Clipchamp
    - Microsoft.WindowsFeedbackHub
    - Microsoft.MicrosoftOfficeHub
    - Microsoft.MicrosoftSolitaireCollection
    - Microsoft.BingNews
    - Microsoft.BingWeather
    getScript: |-
      param($wanted)
      $ErrorActionPreference = 'Stop'
      $installed = foreach ($name in $wanted) {
        if (Get-AppxPackage -AllUsers -Name $name) { $name }
      }
      $provisionedNames = @(Get-AppxProvisionedPackage -Online | Select-Object -ExpandProperty DisplayName)
      $provisioned = @($wanted | Where-Object { $_ -in $provisionedNames })
      return @{ installed = @($installed); provisioned = @($provisioned) }
    testScript: |-
      param($wanted)
      $ErrorActionPreference = 'Stop'
      foreach ($name in $wanted) {
        if (Get-AppxPackage -AllUsers -Name $name) { return $false }
      }
      $provisionedNames = @(Get-AppxProvisionedPackage -Online | Select-Object -ExpandProperty DisplayName)
      foreach ($name in $wanted) {
        if ($name -in $provisionedNames) { return $false }
      }
      return $true
    setScript: |-
      param($wanted)
      $ErrorActionPreference = 'Stop'
      foreach ($name in $wanted) {
        Get-AppxPackage -AllUsers -Name $name | ForEach-Object {
          Write-Host "Removing installed AppX: $($_.PackageFullName)"
          Remove-AppxPackage -Package $_.PackageFullName -AllUsers -ErrorAction Stop
        }
      }
      $provisioned = @(Get-AppxProvisionedPackage -Online)
      foreach ($name in $wanted) {
        $provisioned | Where-Object DisplayName -eq $name | ForEach-Object {
          Write-Host "Removing provisioned AppX: $($_.PackageName)"
          Remove-AppxProvisionedPackage -Online -PackageName $_.PackageName -AllUsers -ErrorAction Stop | Out-Null
        }
      }
  metadata:
    description: Remove a conservative explicit list of unwanted inbox/consumer AppX packages for all users and deprovision them for new users
    winget:
      securityContext: elevated
- type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  name: InstallCascadiaCodeNerdFonts
  dependsOn:
  - PackagePowerShell
  properties:
    input:
      version: '2407.24'
      sha256: E67A68EE3386DB63F48B9054BD196EA752BC6A4EBB4DF35ADCE6733DA50C8474
      files:
      - CascadiaCodeNF.ttf
      - CascadiaMonoNF.ttf
    getScript: |-
      param($desired)
      $fontsDir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
      $wantedFonts = @($desired.files)
      $regPath = 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
      $regValues = @((Get-ItemProperty $regPath -EA SilentlyContinue).PSObject.Properties |
        Where-Object Name -notin 'PSPath','PSParentPath','PSChildName','PSDrive','PSProvider' |
        Select-Object -ExpandProperty Value)
      $filesOk = -not ($wantedFonts | Where-Object { -not (Test-Path (Join-Path $fontsDir $_)) })
      $regOk = -not ($wantedFonts | Where-Object { $fn = $_; -not ($regValues | Where-Object { $_ -like "*\$fn" }) })
      return @{ filesInstalled = $filesOk; registryEntries = $regOk }
    testScript: |-
      param($desired)
      $fontsDir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
      $wantedFonts = @($desired.files)
      $regPath = 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
      $regValues = @((Get-ItemProperty $regPath -EA SilentlyContinue).PSObject.Properties |
        Where-Object Name -notin 'PSPath','PSParentPath','PSChildName','PSDrive','PSProvider' |
        Select-Object -ExpandProperty Value)
      $filesOk = -not ($wantedFonts | Where-Object { -not (Test-Path (Join-Path $fontsDir $_)) })
      $regOk = -not ($wantedFonts | Where-Object { $fn = $_; -not ($regValues | Where-Object { $_ -like "*\$fn" }) })
      return ($filesOk -and $regOk)
    setScript: |-
      param($desired)
      $ErrorActionPreference = 'Stop'
      $Version = $desired.version
      $WantedFonts = @($desired.files)
      $zipUrl = "https://github.com/microsoft/cascadia-code/releases/download/v$Version/CascadiaCode-$Version.zip"
      $workDir = Join-Path $env:TEMP ("CascadiaCode-" + [guid]::NewGuid().ToString('N'))
      $zipPath = Join-Path $workDir 'CascadiaCode.zip'
      $fontsDir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
      $regPath = 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
      $regValues = @((Get-ItemProperty $regPath -ErrorAction SilentlyContinue).PSObject.Properties |
        Where-Object Name -notin 'PSPath','PSParentPath','PSChildName','PSDrive','PSProvider' |
        Select-Object -ExpandProperty Value)
      $filesOk = -not ($WantedFonts | Where-Object { -not (Test-Path (Join-Path $fontsDir $_)) })
      $regOk = -not ($WantedFonts | Where-Object { $fn = $_; -not ($regValues | Where-Object { $_ -like "*\$fn" }) })
      if ($filesOk -and $regOk) { return }
      New-Item -ItemType Directory -Path $workDir -Force | Out-Null
      try {
      New-Item -ItemType Directory -Path $fontsDir -Force | Out-Null
      $ProgressPreference = 'SilentlyContinue'
      Invoke-WebRequest -Uri $zipUrl -OutFile $zipPath -UseBasicParsing
      $expectedHash = $desired.sha256
      $actualHash = (Get-FileHash $zipPath -Algorithm SHA256).Hash
      if ($actualHash -ne $expectedHash) {
        throw "Hash mismatch for CascadiaCode-$Version.zip: expected $expectedHash, got $actualHash"
      }
      Add-Type -AssemblyName System.IO.Compression.FileSystem
      Add-Type -AssemblyName System.Drawing
      $zip = [System.IO.Compression.ZipFile]::OpenRead($zipPath)
      try {
        foreach ($name in $WantedFonts) {
          $entry = $zip.Entries | Where-Object { $_.Name -eq $name } | Select-Object -First 1
          if (-not $entry) { throw "Font not found in archive: $name" }
          $dest = Join-Path $fontsDir $name
          [System.IO.Compression.ZipFileExtensions]::ExtractToFile($entry, $dest, $true)
          $pfc = New-Object System.Drawing.Text.PrivateFontCollection
          try {
            $pfc.AddFontFile($dest)
            $family = $pfc.Families[0].Name
          } finally { $pfc.Dispose() }
          $regName = "$family (TrueType)"
          New-ItemProperty -Path $regPath -Name $regName -Value $dest -PropertyType String -Force | Out-Null
        }
      } finally { $zip.Dispose() }
      } finally { Remove-Item $workDir -Recurse -Force }
  metadata:
    description: Install Microsoft Cascadia Code NF and Cascadia Mono NF 2407.24 for the current user with pinned SHA-256 verification
- type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  name: WindowsTerminalSettings
  dependsOn:
  - PackageWindowsTerminal
  - PackagePowerShell
  - InstallCascadiaCodeNerdFonts
  properties:
    input: |-
      {
          "$help": "https://aka.ms/terminal-documentation",
          "$schema": "https://aka.ms/terminal-profiles-schema",
          "actions": [],
          "copyOnSelect": true,
          "defaultProfile": "{26043d3d-43de-425d-8803-ab90eb274751}",
          "disabledProfileSources": [
              "Windows.Terminal.Wsl",
              "Windows.Terminal.Azure",
              "Windows.Terminal.PowershellCore",
              "Windows.Terminal.SSH"
          ],
          "keybindings": [],
          "newTabMenu": [
              {
                  "type": "remainingProfiles"
              }
          ],
          "profiles": {
              "defaults": {
                  "bellStyle": "taskbar",
                  "colorScheme": "Solarized Dark",
                  "font": {
                      "face": "Cascadia Code NF",
                      "size": 10
                  },
                  "padding": "1,0,0,0",
                  "scrollbarState": "hidden",
                  "startingDirectory": "%USERPROFILE%"
              },
              "list": [
                  {
                      "closeOnExit": "always",
                      "commandline": "%SystemRoot%\\System32\\cmd.exe",
                      "guid": "{26043d3d-43de-425d-8803-ab90eb274751}",
                      "hidden": false,
                      "name": "Command Prompt"
                  },
                  {
                      "closeOnExit": "always",
                      "commandline": "wsl.exe -d Ubuntu",
                      "guid": "{c0f87640-6013-5c50-9c5f-d27b1ae0d344}",
                      "hidden": false,
                      "name": "Ubuntu",
                      "startingDirectory": "~"
                  },
                  {
                      "closeOnExit": "always",
                      "commandline": "pwsh.exe -NoLogo",
                      "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
                      "hidden": false,
                      "icon": "ms-appx:///ProfileIcons/pwsh.png",
                      "name": "PowerShell 7"
                  },
                  {
                      "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                      "hidden": false,
                      "name": "Windows PowerShell"
                  }
              ]
          },
          "schemes": [],
          "searchWebDefaultQueryUrl": "https://www.google.com/search?q=%22%s%22",
          "snapToGridOnResize": true,
          "themes": []
      }
    getScript: |-
      param($desiredRaw)
      $paths = @(
        (Join-Path $env:LOCALAPPDATA 'Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json'),
        (Join-Path $env:LOCALAPPDATA 'Microsoft\Windows Terminal\settings.json')
      )
      $path = $paths | Where-Object { Test-Path $_ } | Select-Object -First 1
      if (-not $path) { return @{ path = $null; configured = $false } }
      return @{ path = $path; configured = $true }
    testScript: |-
      param($desiredRaw)
      $paths = @(
        (Join-Path $env:LOCALAPPDATA 'Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json'),
        (Join-Path $env:LOCALAPPDATA 'Microsoft\Windows Terminal\settings.json')
      )
      $path = $paths | Where-Object { Test-Path $_ } | Select-Object -First 1
      if (-not $path) { return $false }
      return ((Get-Content $path -Raw).Trim() -ceq $desiredRaw.Trim())
    setScript: |-
      param($desiredRaw)
      $ErrorActionPreference = 'Stop'
      $packagedDir = Join-Path $env:LOCALAPPDATA 'Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState'
      $portableDir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows Terminal'
      if (Test-Path (Split-Path $packagedDir -Parent)) { $dir = $packagedDir } else { $dir = $portableDir }
      New-Item -ItemType Directory -Path $dir -Force | Out-Null
      $path = Join-Path $dir 'settings.json'
      if ((Test-Path $path) -and ((Get-Content $path -Raw).Trim() -ceq $desiredRaw.Trim())) { return }
      if ((Test-Path $path) -and -not (Test-Path "$path.pre-dsc.bak")) { Copy-Item $path "$path.pre-dsc.bak" -Force }
      $desiredRaw | Set-Content -Path $path -Encoding UTF8
  metadata:
    description: 'Own Windows Terminal settings.json declaratively: local Command Prompt default, explicit Ubuntu and PowerShell 7 profiles, Cascadia Code NF,
      Solarized Dark, and no duplicate dynamic profiles'
