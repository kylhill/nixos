      - path: "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer"
        name: "AllowOnlineTips"
        type: "DWord"
        value: 0
        description: "Prevent Settings from retrieving online tips and help content"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer"
        name: "HideRecommendedPersonalizedSites"
        type: "DWord"
        value: 1
        description: "Hide personalized website recommendations in Start"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Search"
        name: "AllowCloudSearch"
        type: "DWord"
        value: 0
        description: "Disable cloud search"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Search"
        name: "DisableWebSearch"
        type: "DWord"
        value: 1
        description: "Disable web search from Windows Search"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Search"
        name: "ConnectedSearchUseWeb"
        type: "DWord"
        value: 0
        description: "Do not show Bing web results in Windows Search"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Search"
        name: "AllowSearchToUseLocation"
        type: "DWord"
        value: 0
        description: "Do not use location for Search"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Search"
        name: "ConfigureSearchOnTaskbarMode"
        type: "DWord"
        value: 0
        description: "Hide the Search box and icon from the taskbar on Windows 11 24H2+"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Dsh"
        name: "AllowNewsAndInterests"
        type: "DWord"
        value: 0
        bestEffort: true
        description: "Disable the Windows Widgets feature, including taskbar content"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services"
        name: "fAllowToGetHelp"
        type: "DWord"
        value: 0
        description: "Disable solicited Remote Assistance"
      - path: "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\AppModelUnlock"
        name: "AllowDevelopmentWithoutDevLicense"
        type: "DWord"
        value: 1
        description: "Enable Windows Developer Mode"
      - path: "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\FileSystem"
        name: "LongPathsEnabled"
        type: "DWord"
        value: 1
        description: "Enable Win32 long path support"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Sudo"
        name: "EnableSudo"
        type: "DWord"
        value: 1
        description: "Allow Windows sudo in force-new-window mode"
      - path: "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Sudo"
        name: "Enabled"
        type: "DWord"
        value: 1
        description: "Enable Windows sudo in force-new-window mode"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI"
        name: "AllowRecallEnablement"
        type: "DWord"
        value: 0
        description: "Disable Recall availability and remove Recall bits where supported"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI"
        name: "DisableAIDataAnalysis"
        type: "DWord"
        value: 1
        description: "Disable saving Recall snapshots"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI"
        name: "DisableClickToDo"
        type: "DWord"
        value: 1
        description: "Disable Click to Do where supported"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "TrackingPrevention"
        type: "DWord"
        value: 3
        description: "Set Edge tracking prevention to Strict"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "BrowserSignin"
        type: "DWord"
        value: 0
        description: "Disable account sign-in within Edge"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "NonRemovableProfileEnabled"
        type: "DWord"
        value: 0
        description: "Do not create an automatically signed-in non-removable Edge profile"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "SyncDisabled"
        type: "DWord"
        value: 1
        description: "Disable Edge cloud synchronization"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "WebToBrowserSignInEnabled"
        type: "DWord"
        value: 0
        description: "Prevent Microsoft website sign-in from signing into Edge"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "PasswordManagerEnabled"
        type: "DWord"
        value: 0
        description: "Prevent Edge from saving new passwords"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "BlockThirdPartyCookies"
        type: "DWord"
        value: 1
        description: "Block third-party cookies in regular Edge sessions"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "DefaultCookiesSetting"
        type: "DWord"
        value: 4
        description: "Keep Edge cookies only for the current session"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "SavingBrowserHistoryDisabled"
        type: "DWord"
        value: 1
        description: "Prevent Edge from saving browsing history"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "NetworkPredictionOptions"
        type: "DWord"
        value: 2
        description: "Disable Edge DNS prefetching, preconnection, and page prerendering"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "BackgroundModeEnabled"
        type: "DWord"
        value: 0
        description: "Stop Edge background apps after the last browser window closes"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "StartupBoostEnabled"
        type: "DWord"
        value: 0
        description: "Prevent Edge processes from starting with Windows"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "PaymentMethodQueryEnabled"
        type: "DWord"
        value: 0
        description: "Prevent sites from querying saved payment methods"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "PersonalizationReportingEnabled"
        type: "DWord"
        value: 0
        description: "Disable Edge personalization reporting"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "UserFeedbackAllowed"
        type: "DWord"
        value: 0
        description: "Disable Edge feedback UI"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "AutofillCreditCardEnabled"
        type: "DWord"
        value: 0
        description: "Disable Edge credit-card autofill"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "AutofillAddressEnabled"
        type: "DWord"
        value: 0
        description: "Disable Edge address/form autofill"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "SearchSuggestEnabled"
        type: "DWord"
        value: 0
        description: "Disable Edge search/website suggestions"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "LocalProvidersEnabled"
        type: "DWord"
        value: 0
        description: "Disable Edge address-bar suggestions from local history and favorites"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "EdgeShoppingAssistantEnabled"
        type: "DWord"
        value: 0
        description: "Disable Edge shopping assistant"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "HubsSidebarEnabled"
        type: "DWord"
        value: 0
        description: "Disable Edge sidebar"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "MicrosoftEditorProofingEnabled"
        type: "DWord"
        value: 0
        description: "Disable Microsoft Editor cloud-enhanced proofing"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "ResolveNavigationErrorsUseWebService"
        type: "DWord"
        value: 0
        description: "Disable Edge web service for navigation errors"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "AlternateErrorPagesEnabled"
        type: "DWord"
        value: 0
        description: "Disable Edge similar-site suggestions"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "HideFirstRunExperience"
        type: "DWord"
        value: 1
        description: "Hide Edge first-run experience"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "NewTabPageLocation"
        type: "String"
        value: "about:blank"
        description: "Use a blank Edge new-tab page"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Error Reporting"
        name: "Disabled"
        type: "DWord"
        value: 1
        description: "Disable Windows Error Reporting entirely"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection"
        name: "AllowDeviceNameInDiagnosticData"
        type: "DWord"
        value: 0
        description: "Do not include the device name in Windows diagnostic data"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR"
        name: "AllowGameDVR"
        type: "DWord"
        value: 0
        description: "Disable Windows Game Recording and Broadcasting / Game DVR"
      - path: "HKLM:\\SOFTWARE\\Policies\\WindowsNotepad"
        name: "DisableAIFeatures"
        type: "DWord"
        value: 1
        description: "Disable AI features in Windows Notepad"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "SpotlightExperiencesAndRecommendationsEnabled"
        type: "DWord"
        value: 0
        description: "Disable Edge Spotlight experiences, customized recommendations, notifications, and tips"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "AIGenThemesEnabled"
        type: "DWord"
        value: 0
        description: "Disable AI-generated Edge themes"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "BuiltInAIAPIsEnabled"
        type: "DWord"
        value: 0
        description: "Prevent websites from using Edge built-in AI APIs"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "ComposeInlineEnabled"
        type: "DWord"
        value: 0
        description: "Disable Microsoft 365 Copilot inline writing assistance in Edge for Business"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "CopilotPageContext"
        type: "DWord"
        value: 0
        description: "Prevent Edge Copilot from accessing page context for applicable Entra profiles"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "EdgeEntraCopilotPageContext"
        type: "DWord"
        value: 0
        description: "Prevent Edge Copilot from accessing page content, history, and transcripts for applicable Entra profiles"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "DefaultBrowserSettingsCampaignEnabled"
        type: "DWord"
        value: 0
        description: "Disable Edge campaigns prompting to make Edge/Bing the defaults"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "DiagnosticData"
        type: "DWord"
        value: 0
        description: "Turn off Edge required and optional diagnostic-data collection"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "Microsoft365CopilotChatIconEnabled"
        type: "DWord"
        value: 0
        description: "Hide Microsoft 365 Copilot Chat icon in Edge for Business where applicable"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "ShowMicrosoftRewards"
        type: "DWord"
        value: 0
        description: "Hide Microsoft Rewards experiences and notifications in Edge"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "ShowRecommendationsEnabled"
        type: "DWord"
        value: 0
        description: "Disable Edge feature recommendations and browser-assistance notifications"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "TabServicesEnabled"
        type: "DWord"
        value: 0
        description: "Disable cloud tab-organization suggestions and associated URL/title uploads"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "TextPredictionEnabled"
        type: "DWord"
        value: 0
        description: "Disable cloud-backed Edge text prediction in editable web fields"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "VisualSearchEnabled"
        type: "DWord"
        value: 0
        description: "Disable Edge Visual Search"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "EdgeHistoryAISearchEnabled"
        type: "DWord"
        value: 0
        description: "Disable AI-enhanced natural-language search in Edge browsing history"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "ShowPDFDefaultRecommendationsEnabled"
        type: "DWord"
        value: 0
        description: "Disable prompts to make Edge the default PDF reader"
    getScript: |-
      param($desired)
      $ErrorActionPreference = 'Stop'
      $propertiesByPath = @{}
      $mismatches = foreach ($entry in $desired.values) {
        $current = $null
        $matches = $false
        if (-not $propertiesByPath.ContainsKey($entry.path)) {
          $propertiesByPath[$entry.path] = if (Test-Path -LiteralPath $entry.path) {
            Get-ItemProperty -LiteralPath $entry.path -ErrorAction Stop
          } else { $null }
        }
        $properties = $propertiesByPath[$entry.path]
        if ($null -ne $properties) {
          $property = $properties.PSObject.Properties[$entry.name]
          if ($null -ne $property) {
            $current = $property.Value
            $expected = if ($entry.type -eq 'DWord') {
              [int]$entry.value
            } elseif ($entry.type -eq 'GuidList') {
              [byte[]]@($entry.value | ForEach-Object { ([guid]$_).ToByteArray() })
            } else {
              [string]$entry.value
            }
            $matches = if ($entry.type -eq 'String') {
              $current -ceq $expected
            } elseif ($entry.type -eq 'GuidList') {
              [BitConverter]::ToString([byte[]]$current) -ceq [BitConverter]::ToString([byte[]]$expected)
            } else {
              $current -eq $expected
            }
          }
        }
        if (-not $matches) {
          @{ path = $entry.path; name = $entry.name; current = $current; desired = $entry.value }
        }
      }
      $absentValues = foreach ($entry in $desired.absentValues) {
        if (Get-ItemProperty -LiteralPath $entry.path -Name $entry.name -ErrorAction SilentlyContinue) {
          @{ path = $entry.path; name = $entry.name }
        }
      }
      return @{ mismatches = @($mismatches); presentValues = @($absentValues) }
    testScript: |-
      param($desired)
      $ErrorActionPreference = 'Stop'
      $propertiesByPath = @{}
      foreach ($entry in $desired.values) {
        if (-not $propertiesByPath.ContainsKey($entry.path)) {
          $propertiesByPath[$entry.path] = if (Test-Path -LiteralPath $entry.path) {
            Get-ItemProperty -LiteralPath $entry.path -ErrorAction Stop
          } else { $null }
        }
        $properties = $propertiesByPath[$entry.path]
        if ($null -eq $properties) { return $false }
        $property = $properties.PSObject.Properties[$entry.name]
        if ($null -eq $property) { return $false }
        $expected = if ($entry.type -eq 'DWord') {
          [int]$entry.value
        } elseif ($entry.type -eq 'GuidList') {
          [byte[]]@($entry.value | ForEach-Object { ([guid]$_).ToByteArray() })
        } else {
          [string]$entry.value
        }
        $matches = if ($entry.type -eq 'String') {
          $property.Value -ceq $expected
        } elseif ($entry.type -eq 'GuidList') {
          [BitConverter]::ToString([byte[]]$property.Value) -ceq [BitConverter]::ToString([byte[]]$expected)
        } else {
          $property.Value -eq $expected
        }
        if (-not $matches) { return $false }
      }
      foreach ($entry in $desired.absentValues) {
        if (Get-ItemProperty -LiteralPath $entry.path -Name $entry.name -ErrorAction SilentlyContinue) { return $false }
      }
      return $true
    setScript: |-
      param($desired)
      $ErrorActionPreference = 'Stop'
      $propertiesByPath = @{}
      foreach ($entry in $desired.values) {
        $matches = $false
        if (-not $propertiesByPath.ContainsKey($entry.path)) {
          $propertiesByPath[$entry.path] = if (Test-Path -LiteralPath $entry.path) {
            Get-ItemProperty -LiteralPath $entry.path -ErrorAction Stop
          } else { $null }
        }
        $properties = $propertiesByPath[$entry.path]
        if ($null -ne $properties) {
          $property = $properties.PSObject.Properties[$entry.name]
          if ($null -ne $property) {
            $expected = if ($entry.type -eq 'DWord') {
              [int]$entry.value
            } elseif ($entry.type -eq 'GuidList') {
              [byte[]]@($entry.value | ForEach-Object { ([guid]$_).ToByteArray() })
            } else {
              [string]$entry.value
            }
            $matches = if ($entry.type -eq 'String') {
              $property.Value -ceq $expected
            } elseif ($entry.type -eq 'GuidList') {
              [BitConverter]::ToString([byte[]]$property.Value) -ceq [BitConverter]::ToString([byte[]]$expected)
            } else {
              $property.Value -eq $expected
            }
          }
        }
        if (-not $matches) {
          try {
            if (-not (Test-Path -LiteralPath $entry.path)) {
              New-Item -Path $entry.path -Force -ErrorAction Stop | Out-Null
            }
            $expected = if ($entry.type -eq 'DWord') {
              [int]$entry.value
            } elseif ($entry.type -eq 'GuidList') {
              [byte[]]@($entry.value | ForEach-Object { ([guid]$_).ToByteArray() })
            } else {
              [string]$entry.value
            }
            $propertyType = if ($entry.type -eq 'GuidList') { 'Binary' } else { $entry.type }
            New-ItemProperty -LiteralPath $entry.path -Name $entry.name -Value $expected -PropertyType $propertyType -Force -ErrorAction Stop | Out-Null
            [void]$propertiesByPath.Remove($entry.path)
          } catch {
            $message = "Failed to apply registry setting '$($entry.description)' at '$($entry.path)\\$($entry.name)': $($_.Exception.Message)"
            if ($entry.bestEffort) {
              Write-Warning $message
            } else {
              throw $message
            }
          }
        }
      }
      foreach ($entry in $desired.absentValues) {
        if (Get-ItemProperty -LiteralPath $entry.path -Name $entry.name -ErrorAction SilentlyContinue) {
          try {
            Remove-ItemProperty -LiteralPath $entry.path -Name $entry.name -ErrorAction Stop
          } catch {
            throw "Failed to remove registry setting '$($entry.description)' at '$($entry.path)\\$($entry.name)': $($_.Exception.Message)"
          }
        }
      }
  metadata:
    description: Apply machine-wide Windows registry policies and preferences in one idempotent batch
    winget:
      securityContext: elevated
- type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  name: RegistryUserSettings
  properties:
    input:
      absentValues:
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer"
        name: "NoRecentDocsHistory"
        description: "Let the Start recent-files preference control the Settings toggle"
      values:
      - path: "HKCU:\\Console\\%%Startup"
        name: "DelegationTerminal"
        type: "String"
        value: "{E12CFF52-A866-4C77-9A90-F570A7AA2C6B}"
        description: "Use Windows Terminal as the default terminal application"
      - path: "HKCU:\\Console\\%%Startup"
        name: "DelegationConsole"
        type: "String"
        value: "{2EACA947-7F5F-4CFA-BA87-8F7FBEEFBE69}"
        description: "Use Windows Terminal as the default console host"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Start"
        name: "VisiblePlaces"
        type: "GuidList"
        value:
        - "{52730886-51AA-4243-9F7B-2776584659D4}"
        - "{148A24BC-D60C-4289-A080-6ED9BBA24882}"
        - "{E367B32F-89DE-4355-BFCE-61F37B18A937}"
        description: "Show Settings, File Explorer, and Downloads beside the power button in Start"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Start"
        name: "ShowRecentList"
        type: "DWord"
        value: 0
        description: "Turn off recently installed apps in Start personalization"
      - path: "HKCU:\\Control Panel\\Desktop"
        name: "WindowArrangementActive"
        type: "String"
        value: "1"
        description: "Keep the Windows Snap feature enabled"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Lighting"
        name: "AmbientLightingEnabled"
        type: "DWord"
        value: 0
        description: "Turn off Use Dynamic Lighting on my devices"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "Start_IrisRecommendations"
        type: "DWord"
        value: 0
        description: "Disable Start recommendation content"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "Start_TrackDocs"
        type: "DWord"
        value: 0
        description: "Disable recently opened items in Start, Jump Lists, and File Explorer"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "SnapAssist"
        type: "DWord"
        value: 0
        description: "Do not suggest other windows after snapping a window"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "EnableSnapAssistFlyout"
        type: "DWord"
        value: 0
        description: "Do not show Snap layouts when hovering over a window's maximize button"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "EnableSnapBar"
        type: "DWord"
        value: 0
        description: "Do not show Snap layouts when dragging a window to the top of the screen"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "EnableTaskGroups"
        type: "DWord"
        value: 0
        description: "Do not group snapped windows in taskbar previews, Task View, or Alt+Tab"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "DITest"
        type: "DWord"
        value: 1
        description: "Allow snapping while dragging without reaching the screen edge"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "MultiTaskingAltTabFilter"
        type: "DWord"
        value: 3
        description: "Do not show tabs from apps when snapping or pressing Alt+Tab"
      - path: "HKCU:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer"
        name: "DisableSearchBoxSuggestions"
        type: "DWord"
        value: 1
        description: "Disable web results and suggestions in Windows Search"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Search"
        name: "SearchboxTaskbarMode"
        type: "DWord"
        value: 0
        description: "Hide the Search box and icon from the taskbar for the current user"
      - path: "HKCU:\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent"
        name: "DisableThirdPartySuggestions"
        type: "DWord"
        value: 1
        description: "Disable third-party app and content suggestions in Windows Spotlight experiences"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\SearchSettings"
        name: "IsDynamicSearchBoxEnabled"
        type: "DWord"
        value: 0
        description: "Disable Search Highlights"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager"
        name: "RotatingLockScreenEnabled"
        type: "DWord"
        value: 0
        description: "Use a static lock-screen picture instead of Windows Spotlight"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager"
        name: "RotatingLockScreenOverlayEnabled"
        type: "DWord"
        value: 0
        description: "Hide Windows Spotlight facts and prompts on the lock screen"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager"
        name: "SubscribedContent-338389Enabled"
        type: "DWord"
        value: 0
        description: "Disable the undocumented 'Get tips and suggestions when using Windows' user preference"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager"
        name: "SubscribedContent-338393Enabled"
        type: "DWord"
        value: 0
        description: "Turn off Recommendations and offers in Settings"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Lock Screen"
        name: "SlideshowEnabled"
        type: "DWord"
        value: 0
        description: "Keep the lock screen in static-picture mode"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Lock Screen"
        name: "DetailedStatusApp"
        type: "String"
        value: ""
        description: "Set lock screen status to None"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "Start_TrackProgs"
        type: "DWord"
        value: 0
        description: "Do not track app launches to improve Start and search results"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "TaskbarAl"
        type: "DWord"
        value: 0
        description: "Align Start and taskbar buttons to the left"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "ShowTaskViewButton"
        type: "DWord"
        value: 0
        description: "Hide the Task View button"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\UserProfileEngagement"
        name: "ScoobeSystemSettingEnabled"
        type: "DWord"
        value: 0
        description: "Disable 'finish setting up your PC' prompts"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon"
        name: "RestartApps"
        type: "DWord"
        value: 1
        description: "Automatically save restartable apps and restart them after sign-in"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "ShowSyncProviderNotifications"
        type: "DWord"
        value: 0
        description: "Disable Explorer sync-provider tips/promotional notifications"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "HideFileExt"
        type: "DWord"
        value: 0
        description: "Show file extensions"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
        name: "LaunchTo"
        type: "DWord"
        value: 1
        description: "Open File Explorer to This PC"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer"
        name: "ShowFrequent"
        type: "DWord"
        value: 0
        description: "Disable frequent folders in Quick Access"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer"
        name: "ShowRecent"
        type: "DWord"
        value: 0
        description: "Disable recent files in Quick Access"
      - path: "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer"
        name: "ShowCloudFilesInQuickAccess"
        type: "DWord"
        value: 0
        description: "Disable recommended/cloud files in Quick Access"
      - path: "HKCU:\\SOFTWARE\\Policies\\Microsoft\\Office\\Common\\ClientTelemetry"
        name: "SendTelemetry"
        type: "DWord"
        value: 3
        description: "Configure Microsoft 365 Apps to send neither required nor optional diagnostic data where supported"
      - path: "HKCU:\\Environment"
        name: "POWERSHELL_TELEMETRY_OPTOUT"
        type: "String"
        value: "1"
        description: "Opt out of PowerShell telemetry for future processes"
      - path: "HKCU:\\Environment"
        name: "DOTNET_CLI_TELEMETRY_OPTOUT"
        type: "String"
        value: "1"
        description: "Opt out of .NET CLI telemetry for future processes"
      - path: "HKCU:\\Environment"
        name: "DOTNET_NOLOGO"
        type: "String"
        value: "1"
        description: "Suppress .NET CLI first-run/welcome output"
      - path: "HKCU:\\SOFTWARE\\Policies\\Microsoft\\Windows\\CurrentVersion\\AccountNotifications"
        name: "DisableAccountNotifications"
        type: "DWord"
        value: 1
        description: "Disable Microsoft/local account notifications in the Start user tile"
    getScript: |-
      param($desired)
      $ErrorActionPreference = 'Stop'
      function ConvertTo-GuidBytes($guids) {
        $bytes = New-Object byte[] ($guids.Count * 16)
        for ($i = 0; $i -lt $guids.Count; $i++) {
          ([guid]$guids[$i]).ToByteArray().CopyTo($bytes, $i * 16)
        }
        Write-Output -NoEnumerate $bytes
      }
      $propertiesByPath = @{}
      $mismatches = foreach ($entry in $desired.values) {
        $current = $null
        $matches = $false
        if (-not $propertiesByPath.ContainsKey($entry.path)) {
          $propertiesByPath[$entry.path] = if (Test-Path -LiteralPath $entry.path) {
            Get-ItemProperty -LiteralPath $entry.path -ErrorAction Stop
          } else { $null }
        }
        $properties = $propertiesByPath[$entry.path]
        if ($null -ne $properties) {
          $property = $properties.PSObject.Properties[$entry.name]
          if ($null -ne $property) {
            $current = $property.Value
            $expected = if ($entry.type -eq 'DWord') {
              [int]$entry.value
            } elseif ($entry.type -eq 'GuidList') {
              ConvertTo-GuidBytes $entry.value
            } else {
              [string]$entry.value
            }
            $matches = if ($entry.type -eq 'String') {
              $current -ceq $expected
            } elseif ($entry.type -eq 'GuidList') {
              [BitConverter]::ToString([byte[]]$current) -ceq [BitConverter]::ToString([byte[]]$expected)
            } else {
              $current -eq $expected
            }
          }
        }
        if (-not $matches) {
          @{ path = $entry.path; name = $entry.name; current = $current; desired = $entry.value }
        }
      }
      $absentValues = foreach ($entry in $desired.absentValues) {
        if (Get-ItemProperty -LiteralPath $entry.path -Name $entry.name -ErrorAction SilentlyContinue) {
          @{ path = $entry.path; name = $entry.name }
        }
      }
      return @{ mismatches = @($mismatches); presentValues = @($absentValues) }
    testScript: |-
      param($desired)
      $ErrorActionPreference = 'Stop'
      function ConvertTo-GuidBytes($guids) {
        $bytes = New-Object byte[] ($guids.Count * 16)
        for ($i = 0; $i -lt $guids.Count; $i++) {
          ([guid]$guids[$i]).ToByteArray().CopyTo($bytes, $i * 16)
        }
        Write-Output -NoEnumerate $bytes
      }
      $propertiesByPath = @{}
      foreach ($entry in $desired.values) {
        if (-not $propertiesByPath.ContainsKey($entry.path)) {
          $propertiesByPath[$entry.path] = if (Test-Path -LiteralPath $entry.path) {
            Get-ItemProperty -LiteralPath $entry.path -ErrorAction Stop
          } else { $null }
        }
        $properties = $propertiesByPath[$entry.path]
        if ($null -eq $properties) { return $false }
        $property = $properties.PSObject.Properties[$entry.name]
        if ($null -eq $property) { return $false }
        $expected = if ($entry.type -eq 'DWord') {
          [int]$entry.value
        } elseif ($entry.type -eq 'GuidList') {
          ConvertTo-GuidBytes $entry.value
        } else {
          [string]$entry.value
        }
        $matches = if ($entry.type -eq 'String') {
          $property.Value -ceq $expected
        } elseif ($entry.type -eq 'GuidList') {
          [BitConverter]::ToString([byte[]]$property.Value) -ceq [BitConverter]::ToString([byte[]]$expected)
        } else {
          $property.Value -eq $expected
        }
        if (-not $matches) { return $false }
      }
      foreach ($entry in $desired.absentValues) {
        if (Get-ItemProperty -LiteralPath $entry.path -Name $entry.name -ErrorAction SilentlyContinue) { return $false }
      }
      return $true
    setScript: |-
      param($desired)
      $ErrorActionPreference = 'Stop'
      function ConvertTo-GuidBytes($guids) {
        $bytes = New-Object byte[] ($guids.Count * 16)
        for ($i = 0; $i -lt $guids.Count; $i++) {
          ([guid]$guids[$i]).ToByteArray().CopyTo($bytes, $i * 16)
        }
        Write-Output -NoEnumerate $bytes
      }
      $propertiesByPath = @{}
      foreach ($entry in $desired.values) {
        $matches = $false
        if (-not $propertiesByPath.ContainsKey($entry.path)) {
          $propertiesByPath[$entry.path] = if (Test-Path -LiteralPath $entry.path) {
            Get-ItemProperty -LiteralPath $entry.path -ErrorAction Stop
          } else { $null }
        }
        $properties = $propertiesByPath[$entry.path]
        if ($null -ne $properties) {
          $property = $properties.PSObject.Properties[$entry.name]
          if ($null -ne $property) {
            $expected = if ($entry.type -eq 'DWord') {
              [int]$entry.value
            } elseif ($entry.type -eq 'GuidList') {
              ConvertTo-GuidBytes $entry.value
            } else {
              [string]$entry.value
            }
            $matches = if ($entry.type -eq 'String') {
              $property.Value -ceq $expected
            } elseif ($entry.type -eq 'GuidList') {
              [BitConverter]::ToString([byte[]]$property.Value) -ceq [BitConverter]::ToString([byte[]]$expected)
            } else {
              $property.Value -eq $expected
            }
          }
        }
        if (-not $matches) {
          try {
            Write-Host "Applying registry setting '$($entry.description)' at '$($entry.path)\$($entry.name)'"
            if (-not (Test-Path -LiteralPath $entry.path)) {
              New-Item -Path $entry.path -Force -ErrorAction Stop | Out-Null
            }
            $expected = if ($entry.type -eq 'DWord') {
              [int]$entry.value
            } elseif ($entry.type -eq 'GuidList') {
              ConvertTo-GuidBytes $entry.value
            } else {
              [string]$entry.value
            }
            $propertyType = if ($entry.type -eq 'GuidList') { 'Binary' } else { $entry.type }
            New-ItemProperty -LiteralPath $entry.path -Name $entry.name -Value $expected -PropertyType $propertyType -Force -ErrorAction Stop | Out-Null
            [void]$propertiesByPath.Remove($entry.path)
          } catch {
            Write-Host "Registry setting failed: $($entry.path)\$($entry.name): $($_.Exception.Message)"
            throw "Failed to apply registry setting '$($entry.description)' at '$($entry.path)\\$($entry.name)': $($_.Exception.Message)"
          }
        }
      }
      foreach ($entry in $desired.absentValues) {
        if (Get-ItemProperty -LiteralPath $entry.path -Name $entry.name -ErrorAction SilentlyContinue) {
          try {
            Remove-ItemProperty -LiteralPath $entry.path -Name $entry.name -ErrorAction Stop
          } catch {
            throw "Failed to remove registry setting '$($entry.description)' at '$($entry.path)\$($entry.name)': $($_.Exception.Message)"
          }
        }
      }
  metadata:
    description: Apply current-user Windows registry policies and preferences in one idempotent batch
- type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  name: PersonalizationDefaults
  dependsOn:
  - RegistryUserSettings
  properties:
    getScript: |-
      $marker = Get-ItemProperty -LiteralPath 'HKCU:\SOFTWARE\kyleh\Nixos' -Name PersonalizationDefaultsVersion -ErrorAction SilentlyContinue
      return @{ initialized = ($null -ne $marker -and $marker.PersonalizationDefaultsVersion -eq 1) }
    testScript: |-
      $marker = Get-ItemProperty -LiteralPath 'HKCU:\SOFTWARE\kyleh\Nixos' -Name PersonalizationDefaultsVersion -ErrorAction SilentlyContinue
      return ($null -ne $marker -and $marker.PersonalizationDefaultsVersion -eq 1)
    setScript: |-
      $ErrorActionPreference = 'Stop'
      $markerPath = 'HKCU:\SOFTWARE\kyleh\Nixos'
      $marker = Get-ItemProperty -LiteralPath $markerPath -Name PersonalizationDefaultsVersion -ErrorAction SilentlyContinue
      if ($null -ne $marker -and $marker.PersonalizationDefaultsVersion -eq 1) { return }

      $darkTheme = Join-Path $env:WINDIR 'Resources\Themes\dark.theme'
      if (-not (Test-Path -LiteralPath $darkTheme -PathType Leaf)) {
        throw "The Windows (dark) theme is unavailable: $darkTheme"
      }
      $themePath = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes'
      $personalizePath = Join-Path $themePath 'Personalize'
      New-Item -Path $personalizePath -Force | Out-Null
      New-ItemProperty -LiteralPath $themePath -Name CurrentTheme -Value $darkTheme -PropertyType String -Force | Out-Null
      New-ItemProperty -LiteralPath $personalizePath -Name AppsUseLightTheme -Value 0 -PropertyType DWord -Force | Out-Null
      New-ItemProperty -LiteralPath $personalizePath -Name SystemUsesLightTheme -Value 0 -PropertyType DWord -Force | Out-Null

      $schemes = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('AppEvents\Schemes', $true)
      if ($null -eq $schemes) { throw 'The current user has no Windows sound schemes registry key.' }
      try { $schemes.SetValue('', '.None', [Microsoft.Win32.RegistryValueKind]::String) }
      finally { $schemes.Dispose() }
      Get-ChildItem -LiteralPath 'HKCU:\AppEvents\Schemes\Apps' -Recurse |
        Where-Object { $_.PSChildName -ieq '.Current' } |
        ForEach-Object {
          $key = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey(
            $_.Name.Substring('HKEY_CURRENT_USER\'.Length), $true
          )
          if ($null -eq $key) { throw "Cannot open sound scheme key for writing: $($_.Name)" }
          try { $key.SetValue('', '', [Microsoft.Win32.RegistryValueKind]::String) }
          finally { $key.Dispose() }
        }

      New-Item -Path $markerPath -Force | Out-Null
      New-ItemProperty -LiteralPath $markerPath -Name PersonalizationDefaultsVersion -Value 1 -PropertyType DWord -Force | Out-Null
  metadata:
    description: Set Windows dark theme and No Sounds once, leaving later user changes untouched
- type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  name: RemoveRecommendedInboxApps
  properties:
    input:
    - Microsoft.Copilot
    - Clipchamp.Clipchamp
    - Microsoft.WindowsFeedbackHub
    - Microsoft.XboxGamingOverlay
    - Microsoft.XboxIdentityProvider
    - Microsoft.PowerAutomateDesktop
    - Microsoft.GetHelp
    - Microsoft.Getstarted
    - Microsoft.MicrosoftOfficeHub
    - Microsoft.MicrosoftSolitaireCollection
    - Microsoft.BingSearch
    - Microsoft.BingNews
    - Microsoft.BingWeather
    - Microsoft.Todos
    - Microsoft.OutlookForWindows
    - MicrosoftCorporationII.QuickAssist
    - Microsoft.WindowsSoundRecorder
    - Microsoft.MicrosoftStickyNotes
    - MSTeams
    getScript: |-
      param($wanted)
      $ErrorActionPreference = 'Stop'
      $installedNames = @(Get-AppxPackage -AllUsers | Select-Object -ExpandProperty Name)
      $installed = @($wanted | Where-Object { $_ -in $installedNames })
      $provisionedNames = @(Get-AppxProvisionedPackage -Online | Select-Object -ExpandProperty DisplayName)
      $provisioned = @($wanted | Where-Object { $_ -in $provisionedNames })
      return @{ installed = @($installed); provisioned = @($provisioned) }
    testScript: |-
      param($wanted)
      $ErrorActionPreference = 'Stop'
      $installedNames = @(Get-AppxPackage -AllUsers | Select-Object -ExpandProperty Name)
      if (@($wanted | Where-Object { $_ -in $installedNames }).Count -gt 0) { return $false }
      $provisionedNames = @(Get-AppxProvisionedPackage -Online | Select-Object -ExpandProperty DisplayName)
      foreach ($name in $wanted) {
        if ($name -in $provisionedNames) { return $false }
      }
      return $true
    setScript: |-
      param($wanted)
      $ErrorActionPreference = 'Stop'
      $installed = @(Get-AppxPackage -AllUsers | Where-Object { $_.Name -in $wanted })
      foreach ($package in $installed) {
        Write-Host "Removing installed AppX: $($package.PackageFullName)"
        Remove-AppxPackage -Package $package.PackageFullName -AllUsers -ErrorAction Stop
      }
      $provisioned = @(Get-AppxProvisionedPackage -Online)
      foreach ($name in $wanted) {
        $provisioned | Where-Object DisplayName -eq $name | ForEach-Object {
          Write-Host "Removing provisioned AppX: $($_.PackageName)"
          Remove-AppxProvisionedPackage -Online -PackageName $_.PackageName -AllUsers -ErrorAction Stop | Out-Null
        }
      }
  metadata:
    description: Remove a conservative explicit list of unwanted inbox/consumer AppX packages for all users and deprovision them for new users
    winget:
      securityContext: elevated
- type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  name: InstallCascadiaCodeNerdFonts
  properties:
    input:
      version: '2407.24'
      sha256: E67A68EE3386DB63F48B9054BD196EA752BC6A4EBB4DF35ADCE6733DA50C8474
      files:
      - CascadiaCodeNF.ttf
      - CascadiaMonoNF.ttf
    getScript: |-
      param($desired)
      $fontsDir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
      $wantedFonts = @($desired.files)
      $regPath = 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
      $regValues = @((Get-ItemProperty $regPath -EA SilentlyContinue).PSObject.Properties |
        Where-Object Name -notin 'PSPath','PSParentPath','PSChildName','PSDrive','PSProvider' |
        Select-Object -ExpandProperty Value)
      $filesOk = -not ($wantedFonts | Where-Object { -not (Test-Path (Join-Path $fontsDir $_)) })
      $regOk = -not ($wantedFonts | Where-Object { $fn = $_; -not ($regValues | Where-Object { $_ -like "*\$fn" }) })
      return @{ filesInstalled = $filesOk; registryEntries = $regOk }
    testScript: |-
      param($desired)
      $fontsDir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
      $wantedFonts = @($desired.files)
      $regPath = 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
      $regValues = @((Get-ItemProperty $regPath -EA SilentlyContinue).PSObject.Properties |
        Where-Object Name -notin 'PSPath','PSParentPath','PSChildName','PSDrive','PSProvider' |
        Select-Object -ExpandProperty Value)
      $filesOk = -not ($wantedFonts | Where-Object { -not (Test-Path (Join-Path $fontsDir $_)) })
      $regOk = -not ($wantedFonts | Where-Object { $fn = $_; -not ($regValues | Where-Object { $_ -like "*\$fn" }) })
      return ($filesOk -and $regOk)
    setScript: |-
      param($desired)
      $ErrorActionPreference = 'Stop'
      $Version = $desired.version
      $WantedFonts = @($desired.files)
      $zipUrl = "https://github.com/microsoft/cascadia-code/releases/download/v$Version/CascadiaCode-$Version.zip"
      $workDir = Join-Path $env:TEMP ("CascadiaCode-" + [guid]::NewGuid().ToString('N'))
      $zipPath = Join-Path $workDir 'CascadiaCode.zip'
      $fontsDir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
      $regPath = 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
      $regValues = @((Get-ItemProperty $regPath -ErrorAction SilentlyContinue).PSObject.Properties |
        Where-Object Name -notin 'PSPath','PSParentPath','PSChildName','PSDrive','PSProvider' |
        Select-Object -ExpandProperty Value)
      $filesOk = -not ($WantedFonts | Where-Object { -not (Test-Path (Join-Path $fontsDir $_)) })
      $regOk = -not ($WantedFonts | Where-Object { $fn = $_; -not ($regValues | Where-Object { $_ -like "*\$fn" }) })
      if ($filesOk -and $regOk) { return }
      New-Item -ItemType Directory -Path $workDir -Force | Out-Null
      try {
      New-Item -ItemType Directory -Path $fontsDir -Force | Out-Null
      $ProgressPreference = 'SilentlyContinue'
      Invoke-WebRequest -Uri $zipUrl -OutFile $zipPath -UseBasicParsing
      $expectedHash = $desired.sha256
      $actualHash = (Get-FileHash $zipPath -Algorithm SHA256).Hash
      if ($actualHash -ne $expectedHash) {
        throw "Hash mismatch for CascadiaCode-$Version.zip: expected $expectedHash, got $actualHash"
      }
      Add-Type -AssemblyName System.IO.Compression.FileSystem
      Add-Type -AssemblyName System.Drawing
      $zip = [System.IO.Compression.ZipFile]::OpenRead($zipPath)
      try {
        foreach ($name in $WantedFonts) {
          $entry = $zip.Entries | Where-Object { $_.Name -eq $name } | Select-Object -First 1
          if (-not $entry) { throw "Font not found in archive: $name" }
          $dest = Join-Path $fontsDir $name
          [System.IO.Compression.ZipFileExtensions]::ExtractToFile($entry, $dest, $true)
          $pfc = New-Object System.Drawing.Text.PrivateFontCollection
          try {
            $pfc.AddFontFile($dest)
            $family = $pfc.Families[0].Name
          } finally { $pfc.Dispose() }
          $regName = "$family (TrueType)"
          New-ItemProperty -Path $regPath -Name $regName -Value $dest -PropertyType String -Force | Out-Null
        }
      } finally { $zip.Dispose() }
      } finally { Remove-Item $workDir -Recurse -Force }
  metadata:
    description: Install Microsoft Cascadia Code NF and Cascadia Mono NF 2407.24 for the current user with pinned SHA-256 verification
- type: Microsoft.DSC.Transitional/PowerShellScript
  name: WindowsTerminalSettings
  dependsOn:
  - InstallCascadiaCodeNerdFonts
  - PackagePowerShell
  properties:
    input: |-
      {
          "$help": "https://aka.ms/terminal-documentation",
          "$schema": "https://aka.ms/terminal-profiles-schema",
          "actions": [],
          "copyOnSelect": true,
          "defaultProfile": "{26043d3d-43de-425d-8803-ab90eb274751}",
          "disabledProfileSources": [
              "Windows.Terminal.Wsl",
              "Windows.Terminal.Azure",
              "Windows.Terminal.PowershellCore",
              "Windows.Terminal.SSH"
          ],
          "keybindings": [],
          "newTabMenu": [
              {
                  "type": "remainingProfiles"
              }
          ],
          "profiles": {
              "defaults": {
                  "bellStyle": "taskbar",
                  "colorScheme": "Solarized Dark",
                  "font": {
                      "face": "Cascadia Code NF",
                      "size": 10
                  },
                  "padding": "1,0,0,0",
                  "scrollbarState": "hidden",
                  "startingDirectory": "%USERPROFILE%"
              },
              "list": [
                  {
                      "closeOnExit": "always",
                      "commandline": "%SystemRoot%\\System32\\cmd.exe",
                      "guid": "{26043d3d-43de-425d-8803-ab90eb274751}",
                      "hidden": false,
                      "name": "Command Prompt"
                  },
                  {
                      "closeOnExit": "always",
                      "commandline": "wsl.exe -d Ubuntu",
                      "guid": "{c0f87640-6013-5c50-9c5f-d27b1ae0d344}",
                      "hidden": false,
                      "icon": "ms-appx:///ProfileIcons/{9acb9455-ca41-5af7-950f-6bca1bc9722f}.png",
                      "name": "Ubuntu",
                      "startingDirectory": "~"
                  },
                  {
                      "closeOnExit": "always",
                      "commandline": "pwsh.exe -NoLogo",
                      "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
                      "hidden": false,
                      "icon": "ms-appx:///ProfileIcons/pwsh.png",
                      "name": "PowerShell 7"
                  },
                  {
                      "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                      "hidden": false,
                      "name": "Windows PowerShell"
                  }
              ]
          },
          "schemes": [],
          "searchWebDefaultQueryUrl": "https://www.google.com/search?q=%22%s%22",
          "snapToGridOnResize": true,
          "themes": []
      }
    getScript: |-
      param($desiredRaw)
      $paths = @(
        (Join-Path $env:LOCALAPPDATA 'Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json'),
        (Join-Path $env:LOCALAPPDATA 'Microsoft\Windows Terminal\settings.json')
      )
      $path = $paths | Where-Object { Test-Path $_ } | Select-Object -First 1
      if (-not $path) { return @{ path = $null; configured = $false } }
      return @{ path = $path; configured = $true }
    testScript: |-
      param($desiredRaw)
      $ErrorActionPreference = 'Stop'
      $paths = @(
        (Join-Path $env:LOCALAPPDATA 'Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json'),
        (Join-Path $env:LOCALAPPDATA 'Microsoft\Windows Terminal\settings.json')
      )
      $path = $paths | Where-Object { Test-Path $_ } | Select-Object -First 1
      if (-not $path) { return $false }
      try {
        $current = Get-Content $path -Raw | ConvertFrom-Json -AsHashtable
        $desired = $desiredRaw | ConvertFrom-Json -AsHashtable
        return (($current | ConvertTo-Json -Depth 100 -Compress) -ceq
          ($desired | ConvertTo-Json -Depth 100 -Compress))
      } catch {
        return $false
      }
    setScript: |-
      param($desiredRaw)
      $ErrorActionPreference = 'Stop'
      $packagedDir = Join-Path $env:LOCALAPPDATA 'Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState'
      $portableDir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows Terminal'
      if (Test-Path (Split-Path $packagedDir -Parent)) { $dir = $packagedDir } else { $dir = $portableDir }
      New-Item -ItemType Directory -Path $dir -Force | Out-Null
      $path = Join-Path $dir 'settings.json'
      $desired = $desiredRaw | ConvertFrom-Json -AsHashtable
      if (Test-Path $path) {
        try {
          $current = Get-Content $path -Raw | ConvertFrom-Json -AsHashtable
          if (($current | ConvertTo-Json -Depth 100 -Compress) -ceq
            ($desired | ConvertTo-Json -Depth 100 -Compress)) { return }
        } catch {
          # Replace malformed settings after preserving the original file below.
        }
      }
      if ((Test-Path $path) -and -not (Test-Path "$path.pre-dsc.bak")) { Copy-Item $path "$path.pre-dsc.bak" -Force }
      $desired | ConvertTo-Json -Depth 100 | Set-Content -Path $path -Encoding UTF8
  metadata:
    description: 'Replace Windows Terminal settings and profiles with the declared configuration: local Command Prompt default, explicit Ubuntu and PowerShell 7 profiles, Cascadia Code NF,
      Solarized Dark, and no duplicate dynamic profiles'
