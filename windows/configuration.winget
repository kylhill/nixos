# Windows 11 personal workstation configuration
# Generated 2026-09-21
#
# Shared native Windows state. Apply package-common.winget and exactly one
# package profile separately; windows/bootstrap.ps1 orchestrates all three.
# Apply:
#   winget configure -f .\configuration.winget --accept-configuration-agreements --disable-interactivity
# Test:
#   winget configure test -f .\configuration.winget
# Baseline: Windows 11 Pro, 24H2 or later.
#
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
- type: Microsoft.WinGet/Package
  name: PackagePowerShell
  properties:
    id: Microsoft.PowerShell
    source: winget
- type: Microsoft.WinGet/Package
  name: PackageSops
  properties:
    id: SecretsOPerationS.SOPS
    source: winget
- type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  name: OpenSSHAgentService
  dependsOn:
  - WindowsCapabilities
  properties:
    getScript: |-
      $service = Get-Service -Name ssh-agent -ErrorAction Stop
      return @{ status = "$($service.Status)"; startupType = "$($service.StartType)" }
    testScript: |-
      $service = Get-Service -Name ssh-agent -ErrorAction Stop
      return ($service.Status -eq 'Running' -and $service.StartType -eq 'Automatic')
    setScript: |-
      $ErrorActionPreference = 'Stop'
      Set-Service -Name ssh-agent -StartupType Automatic
      Start-Service -Name ssh-agent
  metadata:
    description: Start the Windows OpenSSH authentication agent automatically
    winget:
      securityContext: elevated
- type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  name: WindowsCapabilities
  properties:
    input:
      removePrefixes:
      - "Microsoft.Wallpapers.Extended~"
      - "Hello.Face"
      - "Browser.InternetExplorer~"
      - "MathRecognizer~"
      - "Print.Management.Console~"
      - "App.StepsRecorder~"
      - "Microsoft.Windows.PowerShell.ISE~"
      - "Microsoft.Windows.Notepad.System~"
      installPrefixes:
      - "OpenSSH.Client~"
      - "VBSCRIPT~"
      - "Media.WindowsMediaPlayer~"
    getScript: |-
      param($desired)
      $ErrorActionPreference = 'Stop'
      $capabilities = @(Get-WindowsCapability -Online)
      $installedToRemove = @($capabilities | Where-Object {
        $capability = $_
        $capability.State -eq 'Installed' -and @(
          $desired.removePrefixes | Where-Object { $capability.Name -like "$_*" }
        ).Count -gt 0
      } | Select-Object -ExpandProperty Name)
      $required = foreach ($prefix in $desired.installPrefixes) {
        $matches = @($capabilities | Where-Object { $_.Name -like "$prefix*" })
        @{
          prefix = $prefix
          available = $matches.Count -gt 0
          installed = @($matches | Where-Object { $_.State -eq 'Installed' }).Count -gt 0
        }
      }
      return @{ installedToRemove = $installedToRemove; required = @($required) }
    testScript: |-
      param($desired)
      $ErrorActionPreference = 'Stop'
      $capabilities = @(Get-WindowsCapability -Online)
      foreach ($prefix in $desired.installPrefixes) {
        if (@($capabilities | Where-Object {
          $_.Name -like "$prefix*" -and $_.State -eq 'Installed'
        }).Count -eq 0) { return $false }
      }
      foreach ($prefix in $desired.removePrefixes) {
        if (@($capabilities | Where-Object {
          $_.Name -like "$prefix*" -and $_.State -eq 'Installed'
        }).Count -gt 0) { return $false }
      }
      return $true
    setScript: |-
      param($desired)
      $ErrorActionPreference = 'Stop'
      $capabilities = @(Get-WindowsCapability -Online)
      foreach ($prefix in $desired.installPrefixes) {
        $matches = @($capabilities | Where-Object { $_.Name -like "$prefix*" })
        if ($matches.Count -eq 0) {
          throw "Required optional Windows capability matching '$prefix*' is not available in this Windows image"
        }
        if (@($matches | Where-Object { $_.State -eq 'Installed' }).Count -gt 0) { continue }
        $capability = $matches | Select-Object -First 1
        try {
          Add-WindowsCapability -Online -Name $capability.Name -ErrorAction Stop | Out-Null
        } catch {
          throw "Failed to install required optional Windows capability '$($capability.Name)': $($_.Exception.Message)"
        }
      }
      $installedToRemove = @($capabilities | Where-Object {
        $capability = $_
        $capability.State -eq 'Installed' -and @(
          $desired.removePrefixes | Where-Object { $capability.Name -like "$_*" }
        ).Count -gt 0
      })
      foreach ($capability in $installedToRemove) {
        try {
          Remove-WindowsCapability -Online -Name $capability.Name -ErrorAction Stop | Out-Null
        } catch {
          throw "Failed to remove optional Windows capability '$($capability.Name)': $($_.Exception.Message)"
        }
      }
  metadata:
    description: Install required and remove unneeded Windows Features on Demand in one batch
    winget:
      securityContext: elevated
- type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  name: RegistryMachineSettings
  properties:
    input:
      absentValues:
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer"
