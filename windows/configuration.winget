      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
        name: "NewTabPageBingChatEnabled"
        type: "DWord"
        value: 0
        description: "Disable Bing/Copilot chat entry points on the Edge new tab page"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge"
