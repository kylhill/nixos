        type: "DWord"
        value: 1
        description: "Disable Windows Advertising ID"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\AppCompat"
        name: "DisableInventory"
        type: "DWord"
        value: 1
        description: "Disable Windows Inventory Collector"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\SQMClient\\Windows"
        name: "CEIPEnable"
        type: "DWord"
        value: 0
        description: "Disable Windows CEIP"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\InputPersonalization"
        name: "AllowInputPersonalization"
        type: "DWord"
        value: 0
        description: "Disable online input personalization"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System"
        name: "EnableActivityFeed"
        type: "DWord"
        value: 0
        description: "Disable Windows activity feed"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System"
        name: "PublishUserActivities"
        type: "DWord"
        value: 0
        description: "Do not publish user activities"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System"
        name: "UploadUserActivities"
        type: "DWord"
        value: 0
        description: "Do not upload user activities"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System"
        name: "AllowClipboardHistory"
        type: "DWord"
        value: 0
        description: "Disable local clipboard history"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System"
        name: "AllowCrossDeviceClipboard"
        type: "DWord"
        value: 0
        description: "Disable cross-device clipboard synchronization"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\AppPrivacy"
        name: "LetAppsGetDiagnosticInfo"
        type: "DWord"
        value: 2
        description: "Force-deny app access to diagnostic information"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\AppCompat"
        name: "DisableUAR"
        type: "DWord"
        value: 1
        description: "Disable Steps Recorder"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection"
        name: "AllowTelemetry"
        type: "DWord"
        value: 1
        description: "Use Required diagnostic data; practical minimum on Windows 11 Pro"
      - path: "HKLM:\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings"
        name: "AllowMUUpdateService"
        type: "DWord"
        value: 1
        description: "Receive updates for other Microsoft products through Windows Update"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection"
        name: "LimitDiagnosticLogCollection"
        type: "DWord"
        value: 1
        description: "Limit diagnostic log collection"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection"
        name: "LimitDumpCollection"
        type: "DWord"
        value: 1
        description: "Limit diagnostic dump collection"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent"
        name: "DisableTailoredExperiencesWithDiagnosticData"
        type: "DWord"
        value: 1
        description: "Disable tailored experiences based on diagnostic data"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection"
        name: "DoNotShowFeedbackNotifications"
        type: "DWord"
        value: 1
        description: "Disable Windows feedback prompts"
      - path: "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\OOBE"
        name: "DisablePrivacyExperience"
        type: "DWord"
        value: 1
